---
import type { HTMLTag, Polymorphic } from "astro/types";

type CSSProperties = astroHTML.JSX.CSSProperties;

type Props<Tag extends HTMLTag> = Polymorphic<{
  as: Tag;
  style?: CSSProperties;
  direction?: CSSProperties["flex-direction"];
  align?: CSSProperties["align-items"];
  justify?: CSSProperties["justify-content"];
  wrap?: CSSProperties["flex-wrap"];
  gap?: CSSProperties["gap"];
  flex?: string | number;
}>;

const {
  as: Component = "div",
  direction,
  align,
  justify,
  wrap,
  gap,
  flex,
  ...props
} = Astro.props;
---

<Component
  {...props}
  style={{
    ...(props.style || {}),
    flexDirection: direction ?? props.style?.flexDirection,
    alignItems: align ?? props.style?.alignItems,
    justifyContent: justify ?? props.style?.justifyContent,
    flexWrap: wrap ?? props.style?.flexWrap,
    gap: gap ?? props.style?.gap,
    flex: flex ?? props.style?.flex,
  }}
  class={`${props.class} flex`}
>
  <slot />
</Component>
